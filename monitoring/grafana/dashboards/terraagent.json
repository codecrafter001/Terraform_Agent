{
  "title": "TerraAgent Overview",
  "uid": "terraagent-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Scan Jobs by Status (rate/5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (rate(jobs_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Scan Errors (rate/5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (agent) (rate(scan_errors_total[5m]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Agent Duration - p95 (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(agent_duration_seconds_bucket[5m])))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Agent Duration - Average (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (agent) (rate(agent_duration_seconds_sum[5m])) / sum by (agent) (rate(agent_duration_seconds_count[5m]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Request Rate (/api/*)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (handler, status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{handler}} [{{status}}]"
        }
      ]
    },
    {
      "id": 6,
      "title": "Total Jobs (all time)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (status) (jobs_total)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
