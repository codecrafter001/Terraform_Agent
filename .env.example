# ==============================================================================
# TerraAgent Environment Configuration
# ==============================================================================

# API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000

# Shared API key checked by services/auth.py on every /api/scan, /api/jobs,
# /api/download, and /api/organizations request; frontend/proxy.ts attaches it
# server-side to every browser call so the browser itself never needs to know
# it. Optional and OFF by default (leave unset/blank to keep today's
# behavior) - but with it unset, the API has NO authentication at all: anyone
# who can reach it can submit AWS credentials to trigger a scan and download
# any job's discovered inventory by job ID alone. Set this before exposing
# the API beyond a fully trusted, closed network - and set the identical
# value for both the backend and frontend services.
TERRAAGENT_API_KEY=

# Redis & Celery - REDIS_URL/CELERY_BROKER_URL/CELERY_RESULT_BACKEND are built
# directly in docker-compose.yml from REDIS_PASSWORD below (they embed it as
# redis://:<password>@terraagent-redis:6379/0), so only the password is set
# here. Required - docker-compose.yml refuses to start any service without it,
# and Redis itself now requires --requirepass. Set this to a real secret;
# there is no safe default, since Redis holds job state and the Celery broker
# and has no other access control.
REDIS_PASSWORD=change-me-to-a-real-secret

# Ollama LLM Service
OLLAMA_HOST=http://terraagent-ollama:11434
OLLAMA_MODEL=codellama

# Infracost (cost estimation for generated Terraform/OpenTofu). Optional - if
# unset, cost_agent reports "not estimated" rather than a fabricated $0.00;
# get a free key at https://www.infracost.io/docs/#2-get-api-key
INFRACOST_API_KEY=

# Storage & Output
OUTPUT_DIR=/tmp/terraagent
ZIP_EXPIRY_HOURS=24
# Backstop for a Celery worker that crashed mid-scan (see services/celery_app.py's
# sweep_stale_jobs task) - a job still "RUNNING" past this many seconds with no
# completion signal gets marked FAILED instead of staying stuck forever.
MAX_JOB_RUNTIME_SECONDS=1800

# PostgreSQL (audit-trail DB) - DATABASE_URL itself is set directly in
# docker-compose.yml so it can reference the terraagent-postgres hostname;
# only the password is overridable here. Required - no safe default; set to a
# real secret, not the literal value below.
POSTGRES_PASSWORD=change-me-to-a-real-secret

# pgAdmin (profile "dev" only - docker compose --profile dev up -d terraagent-pgadmin).
# Dev-tooling only, never started by a plain "docker compose up" - fine to
# leave as a convenience default for local use.
PGADMIN_EMAIL=admin@terraagent.example
PGADMIN_PASSWORD=admin

# Grafana (profile "monitoring" only). Required - no safe default, since this
# profile is meant to be usable in a real deployment for observability.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-real-secret

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost/api
